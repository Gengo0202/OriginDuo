    <string name="show_wifi_summary">最外层绘制 Wi-Fi 弧，弧数跟随信号强度。</string>

    <string name="show_mobile_title">显示移动信号点</string>
    <string name="show_mobile_summary">底部绘制四个电平点表示移动信号强度。</string>


    <string name="show_value_title">显示电量数字</string>
    <string name="show_value_summary">环内显示电量百分比，充电时改为闪电图标。</string>

    <string name="show_bolt_title">充电时显示闪电</string>
    <string name="show_bolt_summary">关闭后环内不画闪电，交还系统原生图标。</string>

    <string name="show_mobile_type_title">网络类型</string>
    <string name="show_mobile_type_summary">网络类型文字的位置：关闭、圆环内，或环外另画一个。</string>
    <string name="mobile_type_off">关闭</string>
    <string name="mobile_type_inside">环内</string>
    <string name="mobile_type_outside">环外</string>



    <string name="data_sim_only_title">仅显示上网卡</string>
    <string name="data_sim_only_summary">双卡时只绘制当前上网卡的读数。</string>



    <string name="perf_power_title">充电功率</string>
    <string name="perf_power_summary">电池图标旁显示充电功率，取自电池自身电流与电压，不足 10W 保留一位小数。</string>

    <string name="perf_temp_title">电池温度</string>
    <string name="perf_temp_summary">电池图标旁显示电池温度，单位摄氏度，取整显示，与充电功率上下两行排列。</string>

    <string name="glyph_scale_title">图标整体尺寸</string>
    <string name="glyph_scale_summary">整个图标相对状态栏给定框的百分比，默认 100%%。状态栏的框只有约 20dp 高，所以只能缩小、不能放大；100%% 就是系统给多大画多大。缩小时描边、圆弧与文字按同一比例一起缩，形状不变。</string>

    <string name="perf_scale_title">读数整体尺寸</string>
    <string name="perf_scale_summary">两项读数在自适应大小之上的百分比，默认 100%%。只开一项时是环外类型字号，两项都开时已经自动缩到两行合起来一个图标高，这里再整体放大或缩小。</string>
    <string name="perf_weight_title">读数字重</string>
    <string name="perf_weight_summary">两项读数文字的粗细，默认 700，可调 100–900。改粗会让字变高，组合态的自适应字号会跟着重算，两行仍合起来一个图标高。</string>

    <string name="perf_pair_title">充电功率与电池温度</string>


    <string name="color_role_title">状态颜色</string>
    <string name="color_role_summary">分别为低电量、充电与危险电量指定颜色。</string>

    <string name="color_low_title">低电量颜色</string>
    <string name="color_charging_title">充电颜色</string>
    <string name="color_critical_title">危险电量颜色</string>
    <string name="color_field_summary">点按选择颜色</string>
